        "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
        "from sklearn.ensemble import RandomForestRegressor, IsolationForest\n",
        "from sklearn.metrics import mean_squared_error, r2_score\n",
        "from sklearn.model_selection import KFold, GridSearchCV, cross_validate\n",
        "# --- 1. Load Data ---\n",
        "# path = \".\"\n",
        "# Ensure you set the correct path to your housing.csv\n",
        "files = os.listdir(path)\n",
        "print(\"Files found:\", files)\n",
        "csv_file_path = os.path.join(path, 'housing.csv')\n",
        "column_names = [\n",
        "    'CRIM', 'ZN', 'INDUS', 'CHAS', 'NOX', 'RM', 'AGE',\n",
        "    'DIS', 'RAD', 'TAX', 'PTRATIO', 'B', 'LSTAT', 'MEDV'\n",
        "]\n",
        "df = pd.read_csv(csv_file_path, header=None, names=column_names, sep='\\s+')\n",
        "\n",
        "y = df['MEDV']\n",
        "X = df.drop('MEDV', axis=1)\n",
        "\n",
        "categorical_cols = ['RAD']\n",
        "numerical_cols = [col for col in X.columns if col not in categorical_cols]\n",
        "\n",
        "# --- 2. Outlier Removal (Isolation Forest) ---\n",
        "# Preparing data for Isolation Forest\n",
        "data_for_iso = X.copy()\n",
        "data_for_iso['MEDV'] = y\n",
        "numerical_cols_iso = numerical_cols + ['MEDV']\n",
        "\n",
        "preprocessor_for_outliers = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('num', SimpleImputer(strategy='mean'), numerical_cols_iso),\n",
        "        ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), categorical_cols)\n",
        "    ])\n",
        "\n",
        "data_processed = preprocessor_for_outliers.fit_transform(data_for_iso)\n",
        "\n",
        "iso_forest = IsolationForest(contamination=0.02, random_state=42)\n",
        "outlier_preds = iso_forest.fit_predict(data_processed)\n",
        "\n",
        "# Filter the data\n",
        "mask = outlier_preds != -1\n",
        "X_clean = X[mask]\n",
        "y_clean = y[mask]\n",
        "\n",
        "print(f\"Original shape: {X.shape}, Cleaned shape: {X_clean.shape}\")\n",
        "\n",
        "# --- 3. Define Pipeline for Random Forest ---\n",
        "# Note: We do NOT do train_test_split here. Nested CV handles splitting.\n",
        "\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=[\n",
        "        ('num', Pipeline(steps=[\n",
        "            ('imputer', SimpleImputer(strategy='mean')),\n",
        "            ('scaler', StandardScaler())\n",
        "        ]), numerical_cols),\n",
        "        ('cat', OneHotEncoder(handle_unknown='ignore'), categorical_cols)\n",
        "    ])\n",
        "\n",
        "pipeline = Pipeline(steps=[\n",
        "    ('preprocessor', preprocessor),\n",
        "    ('regressor', RandomForestRegressor(random_state=42))\n",
        "])\n",
        "\n",
        "# --- 4. Define Hyperparameter Grid ---\n",
        "param_grid = {\n",
        "    # Reduced number of estimators for speed in this example\n",
        "    'regressor__n_estimators': [1000],\n",
        "    'regressor__max_depth': [None, 20,50,200],\n",
        "    'regressor__max_features': ['sqrt', 5], # 1.0 corresponds to \"auto\" in newer sklearn\n",
        "    'regressor__min_samples_split': [2, 5]\n",
        "}\n",
        "\n",
        "# --- 5. Configure Nested Cross-Validation ---\n",
        "\n",
        "# INNER LOOP: Hyperparameter Tuning\n",
        "# This splits the training data to find the best params.\n",
        "inner_cv = KFold(n_splits=4, shuffle=True, random_state=42)\n",
        "# The GridSearchCV object acts as our \"Auto-Tuning Model\"\n",
        "clf = GridSearchCV(\n",
        "    estimator=pipeline,\n",
        "    param_grid=param_grid,\n",
        "    cv=inner_cv,\n",
        "    scoring='neg_mean_squared_error',\n",
        "    n_jobs=-1\n",
        ")\n",
        "# OUTER LOOP: Model Evaluation\n",
        "outer_cv = KFold(n_splits=5, shuffle=True, random_state=42)\n",
        "# We define a dictionary of ALL the metrics we want to track\n",
        "scoring_metrics = {\n",
        "    'rmse': 'neg_root_mean_squared_error',\n",
        "    'r2': 'r2'\n",
        "}\n",
        "print(\"\\nRunning Nested Cross-Validation with Multiple Metrics...\")\n",
        "# We use cross_validate instead of cross_val_score\n",
        "results = cross_validate(\n",
        "    clf,\n",
        "    X_clean,\n",
        "    y_clean,\n",
        "    cv=outer_cv,\n",
        "    scoring=scoring_metrics,\n",
        "    n_jobs=-1,\n",
        "    return_train_score=False # We usually don't need training scores in Nested CV\n",
        ")\n",
        "\n",
        "# --- 6. Report Unbiased Performance ---\n",
        "\n",
        "# Extract the test scores (results returns a dictionary)\n",
        "# Note: RMSE comes back negative, so we multiply by -1\n",
        "test_rmse_scores = -results['test_rmse']\n",
        "test_r2_scores = results['test_r2']\n",
        "\n",
        "print(f\"\\n--- Nested CV Results ---\")\n",
        "print(f\"RMSE per fold: {test_rmse_scores}\")\n",
        "print(f\"R2 per fold:   {test_r2_scores}\")\n",
        "print(\"-\" * 30)\n",
        "print(f\"Average RMSE:  {test_rmse_scores.mean():.4f} (+/- {test_rmse_scores.std():.4f})\")\n",
        "print(f\"Average R2:    {test_r2_scores.mean():.4f} (+/- {test_r2_scores.std():.4f})\")\n",
        "\n",
        "# --- 7. Final Model for Production ---\n",
        "# Nested CV is only for evaluation.\n",
        "# To predict on NEW data tomorrow, you must train on ALL data today.\n",
        "print(\"\\nTraining Final Model on ALL cleaned data...\")\n",
